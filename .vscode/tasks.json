
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Debug",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/Od",
                "/EHsc",
                "/MDd",
                "/nologo",
                "/Fo${workspaceFolder}\\build\\Debug\\",
                "/Fd${workspaceFolder}\\build\\Debug\\vc.pdb",
                "/Fe${workspaceFolder}\\build\\Debug\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$msCompile"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cppbuild",
            "label": "Build Release",
            "command": "cl.exe",
            "args": [
                "/O2",
                "/Ob2",
                "/EHsc",
                "/MD",
                "/nologo",
                "/Fo${workspaceFolder}\\build\\Release\\",
                "/Fe${workspaceFolder}\\build\\Release\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$msCompile"],
            "group": "build"
        }
    ]
}
